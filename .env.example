# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (use a least-privilege role; see docs/DEPLOYMENT.md)
DATABASE_URL="postgresql://spotlight:CHANGE_ME@localhost:5432/spotlight"

# Public URL of the site, no trailing slash (used for canonical URLs, sitemap, emails)
SITE_URL="https://spotlightnigeria-france.com"

# Random secret, 32+ characters (hashes IPs for rate limiting / submissions).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=""

# Required in production before the first administrator exists: /admin/setup/ asks for it.
# (Or create the administrator with `npm run admin:create` and leave this empty.)
SETUP_TOKEN=""

# Secret for the scheduled notification-retry job (/api/cron/notifications). Vercel Cron sends
# it automatically as "Authorization: Bearer <CRON_SECRET>". 16+ random characters.
CRON_SECRET=""

# Client IP detection for rate limits. On Vercel nothing is needed. Behind your own proxy,
# the right-most X-Forwarded-For entry is used; set the number of trusted proxies if there are
# several, or name a trusted header instead (e.g. "cf-connecting-ip" behind Cloudflare).
TRUSTED_PROXY_HOPS=""
TRUSTED_IP_HEADER=""

# ── Media storage ───────────────────────────────────────────────────────────
# "s3" for production (AWS S3, Cloudflare R2, Backblaze B2, MinIO…). "local" is for development only.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com (leave empty for AWS)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL that serves bucket objects (CDN / public bucket). If empty, files are served via /media/.
NEXT_PUBLIC_MEDIA_BASE_URL=""

# ── Email (form notifications, password reset) ──────────────────────────────
# Sender address. Its domain (or the address) must be verified in Amazon SES.
EMAIL_FROM="Spotlight Nigeria <no-reply@spotlightnigeria-france.com>"
NOTIFY_EMAIL="contact@friendsofnigeria.net"

# Amazon SES (recommended): an IAM access key allowed to call ses:SendEmail / ses:SendRawEmail,
# and the AWS region the SES identity is verified in (e.g. eu-west-3 for Paris).
SES_ACCESS_KEY_ID=""
SES_SECRET_ACCESS_KEY=""
SES_REGION=""

# Alternative: any SMTP provider. Only used when the SES_* variables are empty.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ── Development / tests ─────────────────────────────────────────────────────
# Separate database used by `npm test` (it is wiped between tests). Never point at production.
TEST_DATABASE_URL="postgresql://spotlight:CHANGE_ME@localhost:5432/spotlight_test"
